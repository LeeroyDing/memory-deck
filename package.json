{
  "name": "memory-deck",
  "version": "0.1.8",
  "description": "A Decky plugin to find and edit memory values from the Quick Access Menu",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "test:frontend": "jest",
    "test:backend": "cd backend && python3 -m venv venv && . venv/bin/activate && pytest",
    "test": "npm run test:frontend && npm run test:backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CameronRedmore/memory-deck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "Camzie99 <credmore99@gmail.com>",
  "contributors": [
    "HeyItsWaters <iwaters1023@gmail.com>"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/CameronRedmore/memory-deck/issues"
  },
  "homepage": "https://github.com/CameronRedmore/memory-deck#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^4.0.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.130",
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.16",
    "@types/webpack": "^5.28.1",
    "decky-frontend-lib": "~3.24.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "rollup": "^2.79.1",
    "rollup-plugin-import-assets": "^1.1.1",
    "shx": "^0.3.4",
    "ts-jest": "^29.4.6",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "react-icons": "^4.8.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom",
        "decky-frontend-lib"
      ]
    }
  }
}
